supabase.datasource.url=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
supabase.datasource.username=postgres.your-project-ref
supabase.datasource.password=your-supabase-db-password

supabase.api.url=https://your-project-ref.supabase.co
supabase.api.anon-key=your-supabase-anon-key
supabase.api.service-role-key=your-supabase-service-role-key

# Email SMTP Configuration
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.auth=true
mail.smtp.starttls.enable=true
mail.smtp.username=your-email@gmail.com
mail.smtp.password=your-app-password
mail.from=noreply@demo1.dev
mail.enabled=false

# VNPAY Sandbox Configuration
vnpay.tmn.code=YOUR_VNPAY_TMN_CODE
vnpay.hash.secret=YOUR_VNPAY_HASH_SECRET
vnpay.pay.url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
vnpay.return.url=http://localhost:8080/demo1/vnpay_return.jsp
vnpay.api.url=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction


